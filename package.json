{
  "name": "watch-costco",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ext": "esbuild extension/src/content.ts extension/src/background.ts extension/src/options.ts --bundle --format=iife --target=chrome120 --outdir=extension/dist",
    "items": "tsx src/cli.ts",
    "test": "vitest run",
    "build": "tsc",
    "lint": "eslint .",
    "start": "tsx src/main.ts",
    "service:install": "scripts/install-launchd.sh",
    "service:uninstall": "scripts/uninstall-launchd.sh",
    "service:restart": "launchctl kickstart -k gui/$(id -u)/local.costco-price-watcher"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/node-notifier": "^8.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "linkedom": "^0.18.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "node-notifier": "^10.0.1",
    "zod": "^4.6.7"
  }
}
